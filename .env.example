# ================================================================
# Serverless Automation Factory — Environment Configuration
# Copy this file to .env and fill in your real values
# NEVER commit .env to version control
# ================================================================

# ── AWS Credentials ──────────────────────────────────────────────
# IAM user must have: IAMFullAccess, S3FullAccess, LambdaFullAccess,
# DynamoDBFullAccess, SNSFullAccess, SQSFullAccess,
# StepFunctionsFullAccess, EventBridgeFullAccess, CloudWatchLogsFullAccess
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=us-east-1

# ── Flask Config ─────────────────────────────────────────────────
FLASK_SECRET_KEY=change-this-to-a-random-string-min-32-chars
FLASK_DEBUG=false
PORT=5000
HOST=0.0.0.0

# ── Default IAM Role Names (used as defaults in deploy forms) ────
# These are CREATED by the app — they must NOT already exist in IAM
DEFAULT_RESUME_ROLE_NAME=ServerlessFactory-ResumeRole
DEFAULT_ORDER_LAMBDA_ROLE_NAME=ServerlessFactory-OrderLambdaRole
DEFAULT_ORDER_SF_ROLE_NAME=ServerlessFactory-OrderSFRole
DEFAULT_ORDER_EB_ROLE_NAME=ServerlessFactory-OrderEBRole
